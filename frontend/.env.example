# ==============================================================================
# CryptoTrace Frontend — Environment Configuration
# ==============================================================================
#
# Configure the backend API base URL for report generation and investigation services.
# If running the backend locally on port 8000, set:
# VITE_API_BASE_URL=http://localhost:8000
#
# If left unset or empty, requests default to the current host origin (e.g. /api/reports/investigation).

VITE_API_BASE_URL=http://localhost:8000
