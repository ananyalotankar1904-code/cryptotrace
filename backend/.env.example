# Alchemy API Configuration
# Replace with your actual Alchemy API key obtained from https://dashboard.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Network (default is eth-mainnet, can be eth-sepolia, polygon-mainnet, etc.)
ALCHEMY_NETWORK=eth-mainnet

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
